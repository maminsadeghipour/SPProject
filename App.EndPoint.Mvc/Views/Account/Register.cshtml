@using App.Domain.Core.IdentityAgg.DTOs
@model RegisterDto
@{
    Layout = "_AppLayout";
}

<div class="sign widget ">
    <div class="section-title">
        <h5>ثبت نام</h5>
    </div>
    <form asp-controller="Account" asp-action="Register" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <hr />
        <div class="form-group">

            <input type="text" asp-for="Email" class="form-control" placeholder="آدرس ایمیل *">

        </div>
        <div class="form-group">

            <input type="password" asp-for="Password" class="form-control" placeholder="رمز عبور *">
        </div>


        <div class="sign-controls form-group">
            <div class="custom-control custom-checkbox">
                <input id="IsReporter" asp-for="IsCustomer" type="checkbox" class="custom-control-input">
                <label class="custom-control-label" for="IsReporter"> مشتری </label>
            </div>
            <div class="custom-control custom-checkbox">
                <input id="IsVisitor" asp-for="IsExpert" type="checkbox" class="custom-control-input">
                <label class="custom-control-label" for="IsVisitor">متخصص</label>
            </div>
        </div>

        <div class="form-group">
            <button type="submit" class="btn-custom">ثبت نام</button>
        </div>

        <p class="form-group text-center">حساب کاربری دارید؟ <a asp-controller="Account" asp-action="Login" class="btn-link">وارد شوید</a> </p>


    </form>
</div>


@section Scripts {
    <script>$(document).ready(function () {
            $('.sign-controls input[type="checkbox"]').click(function () {
                var currentCheckbox = $(this);
                $('.sign-controls input[type="checkbox"]').not(currentCheckbox).prop('checked', false);
            });
        });</script>
}
